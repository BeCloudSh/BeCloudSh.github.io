---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { getMediumArticles } from "@/utils/getMediumArticles";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import { SOCIALS } from "@/constants";

const allArticles = await getMediumArticles();
const recentArticles = allArticles.slice(0, 3);

const specializations = [
  {
    title: "Microsoft 365 Strategy & Target Platforms",
    description:
      "Viewing Microsoft 365 not as a loose collection of disconnected apps, but as an integrated, scalable operating environment. I focus on establishing clean tenant foundations, clear service boundaries, and manageable operating models that balance user productivity with strong baseline governance.",
    principles: [
      "Ecosystem thinking over fragmented tool adoption",
      "Tenant foundations, identity boundaries, and operating models",
      "Resilient governance frameworks that scale with the organization",
      "Actionable architecture reviews and strategic decision papers",
    ],
  },
  {
    title: "Identity, Access & RBAC Design",
    description:
      "Designing practical access-control and authorization models across Microsoft Entra ID, Intune, Defender, Exchange Online, and Purview. My emphasis is on enforcing strict least privilege and Privileged Identity Management while keeping day-to-day operations sustainable for engineering teams.",
    principles: [
      "Cross-platform least privilege without operational bottlenecks",
      "Scoped administration via Administrative Units and PIM",
      "Privileged access strategies and emergency-access concepts",
      "Maintainable role matrices and clear administrative separation",
    ],
  },
  {
    title: "Cloud Security & Zero Trust Baselines",
    description:
      "Strengthening enterprise resilience across identities, endpoints, collaboration data, and messaging infrastructure. Moving past compliance checkboxes to build defense-in-depth postures with Microsoft Defender XDR and Purview information protection.",
    principles: [
      "Zero Trust-aligned security baselines and posture assessments",
      "Unified Microsoft Defender XDR architecture",
      "Exchange Online and mail-security modernization",
      "Practical data protection, sensitivity labeling, and governance",
    ],
  },
  {
    title: "Tenant Transformations & Systems Evolution",
    description:
      "Guiding organizations through high-stakes tenant transformations—from M&A separations to tenant consolidations and workload modernizations. Emphasizing risk mitigation, dependency mapping, data integrity, and clear validation checkpoints.",
    principles: [
      "Dependency-first migration sequencing and wave planning",
      "Identity transition and cutover architecture",
      "Data compliance, legal-hold considerations, and auditability",
      "Structured validation criteria and technical implementation governance",
    ],
  },
];

const experiences = [
  {
    title: "Global Cloud RBAC & Scoped Governance",
    context:
      "A globally distributed organization needed a consistent authorization model across multiple Microsoft cloud services. The key challenge was giving regional teams enough autonomy to manage local resources without granting tenant-wide admin rights or creating security blind spots.",
    solution:
      "Engineered an end-to-end RBAC and governance model covering Entra ID, Intune, Defender, Exchange Online, Purview, PIM, and emergency-access accounts. Decoupled tenant-wide authority from regional duties, establishing a production-ready balance between centralized oversight and regional operability.",
    technologies: [
      "Microsoft Entra ID",
      "PIM",
      "Administrative Units",
      "Microsoft Intune",
      "Microsoft Defender",
      "Exchange Online",
      "Microsoft Purview",
    ],
  },
  {
    title: "Complex Multi-Tenant Transformation & Migration",
    context:
      "An organizational restructuring required Microsoft 365 workloads and user environments to transition between distinct tenants without disrupting security, compliance, or daily business continuity.",
    solution:
      "Designed a phased migration framework covering identity dependencies, Teams/SharePoint/OneDrive cutovers, legal-hold continuity, audit trails, and explicit points of no return. Provided technical teams and leadership with a transparent steering foundation throughout cutovers.",
    technologies: [
      "Microsoft 365",
      "Microsoft Entra ID",
      "Exchange Online",
      "Microsoft Teams",
      "SharePoint Online",
      "OneDrive",
      "Microsoft Purview",
    ],
  },
  {
    title: "Mail Protection Modernization & Defender Integration",
    context:
      "A distributed enterprise faced fragmented mail security tools and inconsistent policy enforcement, creating operational friction and administrative blind spots.",
    solution:
      "Consolidated mail protection into a cohesive architecture utilizing Defender for Office 365, Exchange Online Protection, identity controls, and tenant-wide security baselines—establishing an integrated telemetry pipeline and reducing tooling complexity.",
    technologies: [
      "Exchange Online",
      "Defender for Office 365",
      "Defender XDR",
      "Microsoft Entra ID",
      "Microsoft Purview",
    ],
  },
  {
    title: "Layered AI Governance & Copilot Foundations",
    context:
      "Organizations are introducing Microsoft 365 Copilot and autonomous agents faster than their underlying data-permission, identity, and lifecycle governance frameworks are evolving.",
    solution:
      "Developed a layered governance framework connecting business accountability, least-privilege data permissions, agent identities, Purview data protection, and Defender monitoring—ensuring secure adoption while preventing data oversharing and orphaned agents.",
    technologies: [
      "Microsoft 365 Copilot",
      "Copilot Studio",
      "Agent 365",
      "Microsoft Entra ID",
      "Microsoft Purview",
      "Microsoft Defender",
    ],
  },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Hero Section -->
    <section
      id="hero"
      class="border-b border-border pt-8 pb-10 sm:pt-12 sm:pb-14"
    >
      <div class="flex flex-col gap-3">
        <span
          class="font-mono text-sm font-semibold tracking-wider text-accent uppercase"
        >
          Cloud & Security Consultant
        </span>
        <h1
          class="text-3xl font-bold tracking-tight text-foreground sm:text-5xl"
        >
          Bene Scheckenbach
        </h1>
        <p
          class="mt-2 max-w-2xl text-lg leading-relaxed font-normal text-foreground/90 sm:text-xl"
        >
          Bridging Microsoft Cloud architecture, modern AI, and human
          systems—grounded in real-world research and field notes from life
          off-duty.
        </p>

        <!-- Certifications & Tech Highlights -->
        <div
          class="mt-3 flex flex-wrap items-center gap-2 font-mono text-xs text-foreground/85"
        >
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            M365 E7 Stack
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            SC-100: Cybersecurity Architect
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            Process & Organization Transformation
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            AI Governance & Zero Trust
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            Fine Dining
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            Travel Dispatches
          </span>
        </div>

        <!-- Hero Actions -->
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href="mailto:info@becloud.sh"
            class="inline-flex items-center gap-2 rounded bg-accent px-4 py-2 font-medium text-background transition-opacity hover:opacity-90"
          >
            <IconMail class="size-4" />
            <span>Get in Touch</span>
          </a>
          <a
            href="/articles"
            class="inline-flex items-center gap-1.5 rounded border border-border px-4 py-2 font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
          >
            <span>Read Articles</span>
            <IconArrowRight class="size-4 rtl:-rotate-180" />
          </a>
        </div>

        {
          SOCIALS.length > 0 && (
            <div class="mt-6 flex items-center gap-3 pt-2">
              <span class="font-mono text-xs text-foreground/70">Connect:</span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <!-- Recent Articles Section -->
    <section id="recent-articles" class="border-b border-border py-12 sm:py-16">
      <div
        class="mb-6 flex flex-col justify-between gap-2 sm:flex-row sm:items-end"
      >
        <div>
          <span
            class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
          >
            Field Notes & Insights
          </span>
          <h2 class="mt-1 text-2xl font-bold sm:text-3xl">Recent Articles</h2>
          <p class="mt-1 text-sm text-foreground/80">
            Directly syndicated from the blog at build time.
          </p>
        </div>
        <a
          href="/articles"
          class="inline-flex items-center gap-1 font-mono text-sm font-medium text-accent decoration-dashed hover:underline"
        >
          <span>All Articles</span>
          <IconArrowRight class="size-4 rtl:-rotate-180" />
        </a>
      </div>

      {
        recentArticles.length > 0 ? (
          <ul class="divide-y divide-border/20">
            {recentArticles.map(article => (
              <ArticleCard article={article} variant="h3" />
            ))}
          </ul>
        ) : (
          <div class="my-6 rounded-lg border border-border/50 bg-background/50 p-6 text-center">
            <p class="text-base font-medium text-foreground">
              New articles are being drafted on the blog.
            </p>
            <p class="mt-1 text-xs text-foreground/75 sm:text-sm">
              Follow along for upcoming insights on Microsoft 365 Architecture,
              Security, and AI.
            </p>
            <a
              href="https://blog.becloud.sh"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-accent underline hover:opacity-80"
            >
              <span>Visit blog.becloud.sh</span>
              <IconArrowRight class="size-3" />
            </a>
          </div>
        )
      }
    </section>

    <!-- Technical Specializations Section -->
    <section id="specializations" class="border-b border-border py-12 sm:py-16">
      <div class="mb-8">
        <span
          class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
        >
          Philosophy & Focus
        </span>
        <h2 class="mt-1 text-2xl font-bold sm:text-3xl">
          Technical Specializations
        </h2>
        <p class="mt-2 text-sm text-foreground/80 sm:text-base">
          Engineering principles and focus areas guiding my work across
          Microsoft cloud environments, identity systems, and organizational
          transformations.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          specializations.map(item => (
            <div class="flex flex-col justify-between rounded-lg border border-border/70 bg-background/50 p-6 transition-all hover:border-accent/80 hover:shadow-sm">
              <div>
                <h3 class="font-mono text-lg font-semibold text-foreground">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-foreground/85">
                  {item.description}
                </p>
              </div>

              <div class="mt-6 border-t border-border/40 pt-4">
                <span class="font-mono text-xs font-semibold tracking-wide text-foreground/70 uppercase">
                  Key Principles & Focus
                </span>
                <ul class="mt-2.5 space-y-1.5 text-xs text-foreground/80">
                  {item.principles.map(principle => (
                    <li class="flex items-start gap-2">
                      <span class="font-bold text-accent select-none">›</span>
                      <span>{principle}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Selected Architectural Work Section -->
    <section id="experience" class="border-b border-border py-12 sm:py-16">
      <div class="mb-8">
        <span
          class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
        >
          Field Experience
        </span>
        <h2 class="mt-1 text-2xl font-bold sm:text-3xl">
          Selected Architectural Work
        </h2>
        <p class="mt-2 text-sm text-foreground/80 sm:text-base">
          A closer look at real-world systems, architectural trade-offs, and
          technical challenges solved in production.
        </p>
      </div>

      <div class="space-y-8">
        {
          experiences.map(item => (
            <div class="rounded-lg border border-border/70 bg-background/50 p-6 transition-all hover:border-accent/80 sm:p-7">
              <h3 class="font-mono text-xl font-bold text-foreground">
                {item.title}
              </h3>

              <div class="mt-4 space-y-4 text-sm">
                <div class="rounded border border-border/40 bg-muted/15 p-4">
                  <span class="mb-1.5 block font-mono text-xs font-semibold text-accent uppercase">
                    Context & Complexity
                  </span>
                  <p class="text-xs leading-relaxed text-foreground/85 sm:text-sm">
                    {item.context}
                  </p>
                </div>

                <div class="rounded border border-border/40 bg-muted/15 p-4">
                  <span class="mb-1.5 block font-mono text-xs font-semibold text-accent uppercase">
                    Architectural Insight & Approach
                  </span>
                  <p class="text-xs leading-relaxed text-foreground/85 sm:text-sm">
                    {item.solution}
                  </p>
                </div>
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-1.5 border-t border-border/30 pt-3">
                <span class="me-1 font-mono text-xs text-foreground/60">
                  Stack:
                </span>
                {item.technologies.map(tech => (
                  <span class="rounded border border-border/30 bg-muted/25 px-2 py-0.5 font-mono text-[11px] text-foreground/80">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Contact CTA Section -->
    <section id="contact" class="py-12 text-center sm:py-16">
      <div
        class="mx-auto max-w-xl rounded-xl border border-border/80 bg-background/60 p-8 sm:p-10"
      >
        <span
          class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
        >
          Let's Connect
        </span>
        <h2 class="mt-2 text-2xl font-bold text-foreground sm:text-3xl">
          Start a Conversation
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-foreground/85 sm:text-base">
          I'm always open to discussing complex cloud architecture, AI
          governance, and distributed systems. Whether you'd like to talk tech,
          exchange field notes, or share travel and dining dispatches—feel free
          to drop a line.
        </p>

        <div class="mt-6 flex justify-center gap-4">
          <a
            href="mailto:info@becloud.sh"
            class="inline-flex items-center gap-2 rounded bg-accent px-5 py-2.5 font-medium text-background transition-opacity hover:opacity-90"
          >
            <IconMail class="size-4" />
            <span>info@becloud.sh</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
