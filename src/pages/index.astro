---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { getMediumArticles } from "@/utils/getMediumArticles";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import { SOCIALS } from "@/constants";

const allArticles = await getMediumArticles();
const recentArticles = allArticles.slice(0, 3);

const services = [
  {
    title: "Microsoft 365 Strategy & Architecture",
    description:
      "I help organizations turn Microsoft 365 into a clear, scalable platform rather than a collection of disconnected services. This includes target architecture, governance, security design, tenant foundations, service roadmaps, and the definition of responsibilities and operating models.",
    engagements: [
      "Microsoft 365 strategy and target architecture",
      "Tenant and identity foundations",
      "Governance and operating models",
      "Security and compliance roadmaps",
      "Architecture reviews and decision papers",
    ],
  },
  {
    title: "Identity, Access & RBAC Architecture",
    description:
      "I design practical access-control models across Microsoft Entra ID, Intune, Microsoft Defender, Exchange Online, and Microsoft Purview. My focus is on least privilege, Privileged Identity Management, administrative boundaries, meaningful separation of duties, and an operating model that teams can actually maintain.",
    engagements: [
      "Cross-platform Microsoft cloud RBAC",
      "Entra ID and PIM role design",
      "Administrative Units and scoped administration",
      "Privileged access and emergency-access concepts",
      "Role matrices, implementation plans, and governance processes",
    ],
  },
  {
    title: "Microsoft 365 Security & Data Protection",
    description:
      "I assess and improve Microsoft 365 security across identity, endpoints, email, collaboration, and data. This includes tenant security assessments, Zero Trust-aligned security baselines, Defender architecture, mail-security modernization, Microsoft Purview, and prioritized remediation roadmaps.",
    engagements: [
      "Microsoft 365 security assessments",
      "Zero Trust and security baseline design",
      "Microsoft Defender architecture",
      "Exchange Online and mail-security modernization",
      "Microsoft Purview information protection and governance",
      "Prioritized remediation and implementation roadmaps",
    ],
  },
  {
    title: "Tenant Transformation & Migration",
    description:
      "I plan and steer Microsoft 365 tenant transformations, including tenant-to-tenant migrations, Exchange Online transitions, tenant separation, and the modernization of identity and endpoint management. I focus on migration sequencing, dependencies, security, user impact, validation, and clearly defined decision points.",
    engagements: [
      "Microsoft 365 tenant-to-tenant migrations",
      "Exchange Online migrations",
      "Tenant separation and consolidation",
      "Migration architecture and cutover planning",
      "Security and compliance considerations",
      "Technical project coordination and implementation governance",
    ],
  },
];

const projects = [
  {
    title: "Enterprise Microsoft Cloud RBAC Architecture",
    challenge:
      "A globally distributed organization needed a consistent authorization model across multiple Microsoft cloud services. Regional teams required enough access to operate independently, while security-critical responsibilities had to remain centrally governed.",
    solution:
      "Designed an end-to-end RBAC and governance architecture covering Entra ID, Intune, Defender, Exchange Online, Purview, PIM, and emergency-access accounts. Limited separation of duties to security-critical areas so regional teams could reliably sustain operations.",
    impact:
      "Created a production-oriented authorization model that balances least privilege, central governance, and regional operability.",
    technologies: [
      "Microsoft Entra ID",
      "PIM",
      "Administrative Units",
      "Microsoft Intune",
      "Microsoft Defender",
      "Exchange Online",
      "Microsoft Purview",
    ],
  },
  {
    title: "Microsoft 365 Tenant-to-Tenant Migration Architecture",
    challenge:
      "An organizational transition required Microsoft 365 workloads and user environments to be moved between tenants without losing sight of security, compliance, usability, and operational continuity.",
    solution:
      "Developed a structured migration approach covering pilot and wave planning, identity dependencies, Teams/SharePoint/OneDrive cutovers, legal-hold limitations, auditability, and clear points of no return.",
    impact:
      "Established a controlled migration framework with transparent dependencies, validation criteria, and cutover decisions that gave technical teams and PMs a common steering foundation.",
    technologies: [
      "Microsoft 365",
      "Microsoft Entra ID",
      "Exchange Online",
      "Microsoft Teams",
      "SharePoint Online",
      "OneDrive",
      "Microsoft Purview",
    ],
  },
  {
    title: "Microsoft 365 Security & Mail Protection Modernization",
    challenge:
      "A distributed organization needed to harmonize Microsoft 365 and email-security controls, reduce fragmented administration, and establish a clearer strategic direction for future mail protection and data security.",
    solution:
      "Developed a security-oriented target approach combining Defender for Office 365, Exchange Online protection, identity controls, Purview, and tenant-wide security baselines.",
    impact:
      "Created a decision-oriented foundation for consolidating controls, reducing operational fragmentation, and moving toward an integrated security architecture.",
    technologies: [
      "Exchange Online",
      "Defender for Office 365",
      "Defender XDR",
      "Microsoft Entra ID",
      "Microsoft Purview",
    ],
  },
  {
    title: "Microsoft 365 AI Governance",
    challenge:
      "Organizations are introducing Microsoft 365 Copilot and custom agents faster than their governance, identity, data-protection, and lifecycle processes are evolving.",
    solution:
      "Designed a layered governance model that connects business accountability, data permissions, agent identities, least privilege, Purview protection, Defender monitoring, and agent lifecycle ownership.",
    impact:
      "Provides organizations with a structured model for adopting AI capabilities with proactive governance, preventing orphaned agents and data oversharing.",
    technologies: [
      "Microsoft 365 Copilot",
      "Copilot Studio",
      "Agent 365",
      "Microsoft Entra ID",
      "Microsoft Purview",
      "Microsoft Defender",
    ],
  },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Hero Section -->
    <section
      id="hero"
      class="border-b border-border pt-8 pb-10 sm:pt-12 sm:pb-14"
    >
      <div class="flex flex-col gap-3">
        <span
          class="font-mono text-sm font-semibold tracking-wider text-accent uppercase"
        >
          Consultant Workplace & Collaboration
        </span>
        <h1
          class="text-3xl font-bold tracking-tight text-foreground sm:text-5xl"
        >
          Bene Scheckenbach
        </h1>
        <p
          class="mt-2 max-w-2xl text-lg leading-relaxed font-normal text-foreground/90 sm:text-xl"
        >
          Bridging Microsoft Cloud architecture, modern AI, and human
          systems—grounded in real-world research and field notes from life
          off-duty.
        </p>

        <!-- Certifications & Tech Highlights -->
        <div
          class="mt-3 flex flex-wrap items-center gap-2 font-mono text-xs text-foreground/85"
        >
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            M365 E7 Stack
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            SC-100: Cybersecurity Architect
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            Process & Organization Transformation
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            AI Governance & Zero Trust
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            Fine Dining
          </span>
          <span class="rounded border border-border/80 bg-muted/20 px-2.5 py-1">
            Travel Dispatches
          </span>
        </div>

        <!-- Hero Actions -->
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href="mailto:info@becloud.sh"
            class="inline-flex items-center gap-2 rounded bg-accent px-4 py-2 font-medium text-background transition-opacity hover:opacity-90"
          >
            <IconMail class="size-4" />
            <span>Get in Touch</span>
          </a>
          <a
            href="/articles"
            class="inline-flex items-center gap-1.5 rounded border border-border px-4 py-2 font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
          >
            <span>Read Articles</span>
            <IconArrowRight class="size-4 rtl:-rotate-180" />
          </a>
        </div>

        {
          SOCIALS.length > 0 && (
            <div class="mt-6 flex items-center gap-3 pt-2">
              <span class="font-mono text-xs text-foreground/70">Connect:</span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <!-- Recent Articles Section -->
    <section id="recent-articles" class="border-b border-border py-12 sm:py-16">
      <div
        class="mb-6 flex flex-col justify-between gap-2 sm:flex-row sm:items-end"
      >
        <div>
          <span
            class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
          >
            Field Notes & Insights
          </span>
          <h2 class="mt-1 text-2xl font-bold sm:text-3xl">Recent Articles</h2>
          <p class="mt-1 text-sm text-foreground/80">
            Directly syndicated from Medium at build time.
          </p>
        </div>
        <a
          href="/articles"
          class="inline-flex items-center gap-1 font-mono text-sm font-medium text-accent decoration-dashed hover:underline"
        >
          <span>All Articles</span>
          <IconArrowRight class="size-4 rtl:-rotate-180" />
        </a>
      </div>

      {
        recentArticles.length > 0 ? (
          <ul class="divide-y divide-border/20">
            {recentArticles.map(article => (
              <ArticleCard article={article} variant="h3" />
            ))}
          </ul>
        ) : (
          <div class="my-6 rounded-lg border border-border/50 bg-background/50 p-6 text-center">
            <p class="text-base font-medium text-foreground">
              New articles are being drafted on Medium.
            </p>
            <p class="mt-1 text-xs text-foreground/75 sm:text-sm">
              Follow along for upcoming insights on Microsoft 365 Architecture,
              Security, and AI.
            </p>
            <a
              href="https://medium.com/@becloudsh"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-accent underline hover:opacity-80"
            >
              <span>Visit Medium Profile (@becloudsh)</span>
              <IconArrowRight class="size-3" />
            </a>
          </div>
        )
      }
    </section>

    <!-- Services Section -->
    <section id="services" class="border-b border-border py-12 sm:py-16">
      <div class="mb-8">
        <span
          class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
        >
          Capabilities
        </span>
        <h2 class="mt-1 text-2xl font-bold sm:text-3xl">Consulting Services</h2>
        <p class="mt-2 text-sm text-foreground/80 sm:text-base">
          Architecture, governance, and security consulting designed for
          sustainable operations and clear decision-making.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          services.map(service => (
            <div class="flex flex-col justify-between rounded-lg border border-border/70 bg-background/50 p-6 transition-all hover:border-accent/80 hover:shadow-sm">
              <div>
                <h3 class="font-mono text-lg font-semibold text-foreground">
                  {service.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-foreground/85">
                  {service.description}
                </p>
              </div>

              <div class="mt-6 border-t border-border/40 pt-4">
                <span class="font-mono text-xs font-semibold tracking-wide text-foreground/70 uppercase">
                  Typical Engagements
                </span>
                <ul class="mt-2.5 space-y-1.5 text-xs text-foreground/80">
                  {service.engagements.map(item => (
                    <li class="flex items-start gap-2">
                      <span class="font-bold text-accent select-none">›</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Projects / Case Studies Section -->
    <section id="projects" class="border-b border-border py-12 sm:py-16">
      <div class="mb-8">
        <span
          class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
        >
          Case Studies
        </span>
        <h2 class="mt-1 text-2xl font-bold sm:text-3xl">Featured Projects</h2>
        <p class="mt-2 text-sm text-foreground/80 sm:text-base">
          Selected architectural frameworks, transformations, and security
          modernization projects.
        </p>
      </div>

      <div class="space-y-8">
        {
          projects.map(project => (
            <div class="rounded-lg border border-border/70 bg-background/50 p-6 transition-all hover:border-accent/80 sm:p-7">
              <h3 class="font-mono text-xl font-bold text-foreground">
                {project.title}
              </h3>

              <div class="mt-4 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
                <div class="rounded border border-border/40 bg-muted/15 p-3.5">
                  <span class="mb-1 block font-mono text-xs font-semibold text-accent uppercase">
                    The Challenge
                  </span>
                  <p class="text-xs leading-relaxed text-foreground/85 sm:text-sm">
                    {project.challenge}
                  </p>
                </div>
                <div class="rounded border border-border/40 bg-muted/15 p-3.5">
                  <span class="mb-1 block font-mono text-xs font-semibold text-accent uppercase">
                    The Impact
                  </span>
                  <p class="text-xs leading-relaxed text-foreground/85 sm:text-sm">
                    {project.impact}
                  </p>
                </div>
              </div>

              <div class="mt-4">
                <span class="mb-1 block font-mono text-xs font-semibold text-foreground/70 uppercase">
                  Architecture & Solution
                </span>
                <p class="text-xs leading-relaxed text-foreground/85 sm:text-sm">
                  {project.solution}
                </p>
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-1.5 border-t border-border/30 pt-3">
                <span class="me-1 font-mono text-xs text-foreground/60">
                  Stack:
                </span>
                {project.technologies.map(tech => (
                  <span class="rounded border border-border/30 bg-muted/25 px-2 py-0.5 font-mono text-[11px] text-foreground/80">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Contact CTA Section -->
    <section id="contact" class="py-12 text-center sm:py-16">
      <div
        class="mx-auto max-w-xl rounded-xl border border-border/80 bg-background/60 p-8 sm:p-10"
      >
        <span
          class="font-mono text-xs font-semibold tracking-wider text-accent uppercase"
        >
          Let's Connect
        </span>
        <h2 class="mt-2 text-2xl font-bold text-foreground sm:text-3xl">
          Start a Conversation
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-foreground/85 sm:text-base">
          Whether you are planning an M365 tenant migration, reviewing your
          cloud security posture, or establishing AI governance frameworks—feel
          free to reach out.
        </p>

        <div class="mt-6 flex justify-center gap-4">
          <a
            href="mailto:info@becloud.sh"
            class="inline-flex items-center gap-2 rounded bg-accent px-5 py-2.5 font-medium text-background transition-opacity hover:opacity-90"
          >
            <IconMail class="size-4" />
            <span>info@becloud.sh</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
